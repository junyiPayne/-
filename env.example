# 学生健康管理系统 - 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置
# 命令: cp env.example .env

# ============================================
# 数据库配置
# ============================================
# 数据库类型：sqlite（本地开发）或 mysql（Docker/生产环境）
DB_TYPE=mysql

# MySQL 配置（当 DB_TYPE=mysql 时使用）
DB_HOST=db
DB_PORT=3306
DB_USER=bs_user
DB_PASSWORD=password
DB_NAME=bs_system
MYSQL_ROOT_PASSWORD=rootpassword

# ============================================
# Flask 配置
# ============================================
FLASK_ENV=production
SECRET_KEY=change-me-in-production-please-use-random-string
JWT_SECRET_KEY=change-me-in-production-please-use-random-string

# ============================================
# CORS 配置
# ============================================
# 允许跨域的域名，多个用逗号分隔
# 示例：http://localhost:8080,http://192.168.1.100:80
CORS_ORIGINS=http://localhost:8080

# ============================================
# AI 功能配置（可选）
# ============================================
# DeepSeek API（推荐）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
AI_PROVIDER=deepseek

# 或使用通义千问 API
# QWEN_API_KEY=your-qwen-api-key-here
# AI_PROVIDER=qwen

# ============================================
# 说明
# ============================================
# 1. 生产环境部署时，请务必修改 SECRET_KEY 和 JWT_SECRET_KEY
# 2. 可以使用以下命令生成随机密钥：
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. 如果不需要 AI 功能，可以不配置 DEEPSEEK_API_KEY 和 QWEN_API_KEY
# 4. Docker 模式下，DB_HOST 应设置为 'db'（Docker Compose 服务名）
# 5. 本地开发模式下，DB_HOST 应设置为 'localhost'
